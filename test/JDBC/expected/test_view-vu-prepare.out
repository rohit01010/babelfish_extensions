CREATE VIEW my_sp_special_columns_view AS
    SELECT CASE 1 WHEN 1 THEN cast('abc' as sysname) WHEN 2 THEN cast('abc' as sysname) ELSE cast('abc' as sysname) END AS result;
GO

select column_name, data_type from information_schema.columns where table_name like '%my_sp_special_columns_view%';
GO
~~START~~
nvarchar#!#nvarchar
result#!#varchar
~~END~~


-- psql
select attrelid, attname, atttypid::regtype::text from pg_attribute where attrelid::regclass::text like '%sp_special_columns_view%';
GO
~~START~~
oid#!#name#!#text
19890#!#scope#!#smallint
19890#!#column_name#!#sys.sysname
19890#!#data_type#!#smallint
19890#!#type_name#!#sys.sysname
19890#!#precision#!#integer
19890#!#length#!#integer
19890#!#scale#!#smallint
19890#!#pseudo_column#!#smallint
19890#!#is_nullable#!#integer
19890#!#table_qualifier#!#sys.sysname
19890#!#table_owner#!#sys.sysname
19890#!#table_name#!#sys.sysname
19890#!#constraint_type#!#sys.sysname
19890#!#constraint_name#!#sys.sysname
19890#!#index_id#!#integer
85695#!#result#!#sys."varchar"
~~END~~

